# Eurocode 3 Chat Application - Environment Variables

# LLM Configuration
# -----------------
# Set to "false" to use real LLM API, "true" for mock responses
USE_MOCK_LLM=true

# LLM Provider: "openai", "anthropic", "ollama", "local"
LLM_PROVIDER=openai

# API Keys (set based on your provider)
OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: Custom API base URL (for local models or proxies)
# API_BASE_URL=http://localhost:11434/v1

# Optional: Specific model to use
# LLM_MODEL=gpt-4-turbo-preview

# Rate Limiting
# -------------
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=500

# Database
# --------
DB_PATH=conversations.db

# Server Configuration
# --------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false
